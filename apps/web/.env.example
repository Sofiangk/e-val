# Base URL of the NestJS API (no trailing slash)
VITE_APP_API_URL=http://localhost:3000

# Base URL for uploaded assets
VITE_APP_IMAGE_URL=http://localhost:3000/storage

# When true, the api layer serves responses from src/mocks instead of the network.
# Can also be toggled at runtime in the browser: localStorage.setItem('useMocks','true')
VITE_USE_MOCKS=true
