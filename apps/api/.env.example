# Local dev uses SQLite (zero setup). For production, switch the datasource
# provider in prisma/schema.prisma to "postgresql" and set a Postgres URL here.
DATABASE_URL="file:./dev.db"

# JWT secrets — generate strong random values in production.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="1h"
JWT_REFRESH_TTL_DAYS="30"

# Comma-separated list of allowed CORS origins (the web app).
CORS_ORIGINS="http://localhost:5173"

PORT=3000
