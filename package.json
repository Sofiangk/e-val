{
  "name": "e-val",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@e-val/web",
    "dev:api": "turbo run dev --filter=@e-val/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @e-val/api db:migrate",
    "db:seed": "pnpm --filter @e-val/api db:seed",
    "db:reset": "pnpm --filter @e-val/api db:reset"
  },
  "devDependencies": {
    "turbo": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt"
    ]
  }
}
